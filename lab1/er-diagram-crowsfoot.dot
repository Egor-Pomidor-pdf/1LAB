digraph ER {
    graph [rankdir=LR, splines=spline, nodesep=0.8, ranksep=1.6, bgcolor="white",
           fontname="Helvetica", labelloc="t", fontsize=20,
           label="Система бронирования гостиниц — ER-диаграмма (Crow's Foot)"];
    node  [shape=plaintext, fontname="Helvetica", fontsize=11];
    edge  [dir=both, color="#333333", penwidth=1.2, fontname="Helvetica", fontsize=10, labeldistance=1.5, labelfloat=false];

    room_types [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
        <TR><TD BGCOLOR="#4A6FA5" COLSPAN="2"><FONT COLOR="white"><B>room_types</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD></TR>
        <TR><TD ALIGN="LEFT">U</TD><TD ALIGN="LEFT">name</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">capacity</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">base_price</TD></TR>
      </TABLE>>];

    hotels [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
        <TR><TD BGCOLOR="#4A6FA5" COLSPAN="2"><FONT COLOR="white"><B>hotels</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD></TR>
        <TR><TD ALIGN="LEFT">U1</TD><TD ALIGN="LEFT">name</TD></TR>
        <TR><TD ALIGN="LEFT">U1</TD><TD ALIGN="LEFT">city</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">address</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">stars</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">phone</TD></TR>
      </TABLE>>];

    rooms [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
        <TR><TD BGCOLOR="#4A6FA5" COLSPAN="2"><FONT COLOR="white"><B>rooms</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD></TR>
        <TR><TD ALIGN="LEFT">FK,U1</TD><TD ALIGN="LEFT">hotel_id</TD></TR>
        <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">type_id</TD></TR>
        <TR><TD ALIGN="LEFT">U1</TD><TD ALIGN="LEFT">room_number</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">floor</TD></TR>
      </TABLE>>];

    guests [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
        <TR><TD BGCOLOR="#4A6FA5" COLSPAN="2"><FONT COLOR="white"><B>guests</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">first_name</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">last_name</TD></TR>
        <TR><TD ALIGN="LEFT">U</TD><TD ALIGN="LEFT">passport_no</TD></TR>
        <TR><TD ALIGN="LEFT">U</TD><TD ALIGN="LEFT">email</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">phone</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">birth_date</TD></TR>
      </TABLE>>];

    bookings [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
        <TR><TD BGCOLOR="#4A6FA5" COLSPAN="2"><FONT COLOR="white"><B>bookings</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD></TR>
        <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">guest_id</TD></TR>
        <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">room_id</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">check_in</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">check_out</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">guests_count</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">total_price</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD></TR>
      </TABLE>>];

    payments [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
        <TR><TD BGCOLOR="#4A6FA5" COLSPAN="2"><FONT COLOR="white"><B>payments</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD></TR>
        <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">booking_id</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">amount</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">paid_at</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">method</TD></TR>
      </TABLE>>];

    // arrowtail=tee  — ровно один со стороны родителя
    // arrowhead=crow — «многие» со стороны потомка (odot = может быть ноль)
    hotels     -> rooms    [arrowtail=tee, arrowhead=crowodot, label="CASCADE"];
    room_types -> rooms    [arrowtail=tee, arrowhead=crowodot, label="RESTRICT"];
    guests     -> bookings [arrowtail=tee, arrowhead=crowodot, label="RESTRICT"];
    rooms      -> bookings [arrowtail=tee, arrowhead=crowodot, label="RESTRICT"];
    bookings   -> payments [arrowtail=tee, arrowhead=crowodot, label="CASCADE"];
}
